{
  "name": "kill-da-corona",
  "version": "2.0.0",
  "description": "Kill da Corona - a toon first person arcade game built with three.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,css}\" index.html",
    "prepare": "husky"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.187.0"
  },
  "lint-staged": {
    "*.{js,css,html}": "prettier --write"
  },
  "prettier": {
    "printWidth": 80,
    "trailingComma": "es5"
  },
  "browserslist": [
    "defaults and supports webgl2",
    "not op_mini all"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  }
}
